# Required for auth and Prisma (MongoDB Atlas connection string).
DATABASE_URL=
NEXTAUTH_SECRET=
# Local: http://localhost:3000 — Vercel: https://your-project.vercel.app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth (leave blank if you only use email/password).
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Nodemailer. Leave blank in local development to use the console OTP preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary. CLOUDINARY_URL is server-only. The upload preset must be unsigned.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_URL=

# Optional: AdSense (set NEXT_PUBLIC_SHOW_ADS=false to hide all slots).
NEXT_PUBLIC_SHOW_ADS=true
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: canonical URLs in SEO helpers.
NEXT_PUBLIC_SITE_URL=
